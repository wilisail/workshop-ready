# Optional Firebase connector only. Leave these blank for the Vercel/browser bead counter.
# Public web configuration is project identity, not a server credential.
# Values alone do not select Firebase or verify a connection.
# Never add service-account credentials or App Check debug tokens here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_GEMINI_MODEL=gemini-3.5-flash-lite
# LOCAL DEVELOPMENT ONLY. Never enable this in a public build.
VITE_APPCHECK_DEBUG=false
