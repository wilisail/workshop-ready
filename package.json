{
  "name": "workshop-ready",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Wolbachia container QA and research workbench with a small Vercel/browser image counter, numeric ML evaluation and accountable inspection planning.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "capacity": "node scripts/read-capacity.mjs",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts && node scripts/check-server-build.mjs",
    "test:offline": "playwright test"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
